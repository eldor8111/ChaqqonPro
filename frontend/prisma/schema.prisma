generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SuperAdmin {
  id           String @id @default(cuid())
  passwordHash String
}

model PlatformUser {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  agentCode    String?  @unique
  passwordHash String
  permissions  String   @default("[]")
  role         String
  status       String   @default("active")
  createdAt    DateTime @default(now())
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  tenantId  String?
  role      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Tenant {
  id                   String                 @id @default(cuid())
  shopCode             String                 @unique
  billingId            String?                @unique
  shopName             String
  ownerName            String
  phone                String
  email                String
  address              String
  plan                 String
  status               String
  adminUsername        String
  adminPasswordHash    String
  settings             String?
  agentCode            String?
  createdAt            DateTime               @default(now())
  expiresAt            DateTime?
  balance              Float                  @default(0)
  tariffId             String?
  isTrial              Boolean                @default(false)
  attendances          Attendance[]
  auditLogs            AuditLog[]
  balanceLogs          BalanceLog[]
  customers            Customer[]
  deliveryOrders       DeliveryOrder[]
  inventoryCounts      InventoryCount[]
  expenditures         InventoryExpenditure[]
  receipts             InventoryReceipt[]
  transfers            InventoryTransfer[]
  writeoffs            InventoryWriteoff[]
  kdsOrders            KDSOrder[]
  kassiHarakatlar      KassiHarakat[]
  pharmacyDrugs        PharmacyDrug[]
  products             Product[]
  smartRecommendations SmartRecommendation[]
  ubtReservations      SmartReservation[]
  smartTables          SmartTable[]
  staff                Staff[]
  tariff               Tariff?                @relation(fields: [tariffId], references: [id])
  transactions         Transaction[]

  @@index([adminUsername])
  @@index([phone])
  @@index([agentCode])
}

model Product {
  id               String                 @id @default(cuid())
  tenantId         String
  name             String
  sku              String?
  barcode          String?
  category         String
  sellingPrice     Float
  costPrice        Float
  stock            Int                    @default(0)
  minStock         Int                    @default(10)
  unit             String
  image            String?
  createdAt        DateTime               @default(now())
  printerIp        String?
  isSetMenu        Int?                   @default(0)
  modifiers        String?
  type             String?                @default("taom")
  warehouse        String?
  inStock          Int?                   @default(1)
  hasBarcode       Int?                   @default(0)
  autoCalculate    Int?                   @default(1)
  inventoryCounts  InventoryCount[]
  expenditures     InventoryExpenditure[]
  receipts         InventoryReceipt[]
  transfers        InventoryTransfer[]
  writeoffs        InventoryWriteoff[]
  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionItems TransactionItem[]

  @@index([tenantId])
}

model InventoryReceipt {
  id           String    @id @default(cuid())
  tenantId     String
  date         DateTime  @default(now())
  supplier     String
  productId    String?
  productName  String
  quantity     Int
  unit         String
  costPrice    Float
  totalCost    Float
  warehouse    String
  notes        String?
  status       String
  arrivedAt    DateTime?
  registeredAt DateTime?
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())
  currency     String?   @default("UZS")
  invoiceNo    String?
  documentId   String?
  costPriceUzs Float?    @default(0)
  totalCostUzs Float?    @default(0)
  product      Product?  @relation(fields: [productId], references: [id])
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model InventoryExpenditure {
  id            String   @id @default(cuid())
  tenantId      String
  date          DateTime @default(now())
  productId     String?
  productName   String
  quantity      Int
  unit          String
  reason        String
  fromWarehouse String
  employee      String
  notes         String?
  createdAt     DateTime @default(now())
  product       Product? @relation(fields: [productId], references: [id])
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model InventoryTransfer {
  id            String   @id @default(cuid())
  tenantId      String
  date          DateTime @default(now())
  productId     String?
  productName   String
  quantity      Int
  unit          String
  fromWarehouse String
  toWarehouse   String
  employee      String
  status        String
  notes         String?
  createdAt     DateTime @default(now())
  product       Product? @relation(fields: [productId], references: [id])
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model InventoryCount {
  id          String   @id @default(cuid())
  tenantId    String
  date        DateTime @default(now())
  warehouse   String
  productId   String?
  productName String
  systemStock Int
  actualStock Int
  difference  Int
  unit        String
  employee    String
  status      String
  createdAt   DateTime @default(now())
  product     Product? @relation(fields: [productId], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model InventoryWriteoff {
  id          String   @id @default(cuid())
  tenantId    String
  date        DateTime @default(now())
  productId   String?
  productName String
  quantity    Int
  unit        String
  reason      String
  totalLoss   Float
  approvedBy  String
  status      String
  createdAt   DateTime @default(now())
  product     Product? @relation(fields: [productId], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Staff {
  id                  String        @id @default(cuid())
  tenantId            String
  name                String
  role                String
  username            String        @unique
  passwordHash        String
  permissions         String
  branch              String
  phone               String        @default("")
  printerIp           String        @default("")
  staffMeta           String        @default("{}")
  status              String
  sales               Float         @default(0)
  transactions        Int           @default(0)
  createdAt           DateTime      @default(now())
  tenant              Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionsCreated Transaction[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([username, status])
}

model Customer {
  id             String        @id @default(cuid())
  tenantId       String
  name           String
  phone          String?
  bonusPoints    Int           @default(0)
  segment        String
  totalPurchases Float         @default(0)
  lastVisit      DateTime?
  createdAt      DateTime      @default(now())
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions   Transaction[]

  @@unique([tenantId, phone])
  @@index([tenantId])
}

model Transaction {
  id         String            @id @default(cuid())
  tenantId   String
  amount     Float
  method     String
  status     String
  customerId String?
  kassirId   String?
  kassirName String?
  notes      String?
  createdAt  DateTime          @default(now())
  kassir     Staff?            @relation(fields: [kassirId], references: [id])
  customer   Customer?         @relation(fields: [customerId], references: [id])
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items      TransactionItem[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([customerId])
  @@index([kassirId])
}

model TransactionItem {
  id            String      @id @default(cuid())
  transactionId String
  productId     String?
  name          String
  quantity      Int
  price         Float
  discount      Float       @default(0)
  total         Float
  product       Product?    @relation(fields: [productId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
}

model PharmacyDrug {
  id                   String    @id @default(cuid())
  tenantId             String
  name                 String
  barcode              String?
  dosage               String
  manufacturer         String
  sellingPrice         Float
  costPrice            Float
  stock                Int
  expiryDate           DateTime?
  requiresPrescription Boolean   @default(false)
  category             String?
  createdAt            DateTime  @default(now())
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model SmartPrinter {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  ipAddress   String
  port        Int      @default(9100)
  description String   @default("")
  role        String   @default("cashier") // cashier | kitchen | bar
  paperWidth  Int      @default(80) // 58 | 80 mm
  status      String   @default("unknown") // online | offline | unknown
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  lastSeenAt  DateTime?
  latencyMs   Int?
  createdAt   DateTime @default(now())
  jobs        PrintJob[]

  @@index([tenantId])
}

model PrintJob {
  id          String    @id @default(cuid())
  tenantId    String
  printerId   String
  type        String    @default("receipt") // receipt | kitchen | report | test
  payload     String // JSON: PrinterService.PrintJob formati
  status      String    @default("pending") // pending | claimed | printing | done | failed | cancelled | expired
  priority    Int       @default(5) // 1 = eng yuqori
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  claimedBy   String?
  claimedAt   DateTime?
  printedAt   DateTime?
  nextAttemptAt DateTime?
  lastError   String?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  printer     SmartPrinter @relation(fields: [printerId], references: [id], onDelete: Cascade)
  logs        PrintLog[]

  @@index([tenantId, status])
  @@index([printerId, status])
}

model PrintLog {
  id         String   @id @default(cuid())
  jobId      String
  printerId  String
  tenantId   String
  event      String // created | claimed | printing | done | retry | failed | cancelled | expired | requeued
  detail     String?
  agentId    String?
  durationMs Int?
  createdAt  DateTime @default(now())
  job        PrintJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([jobId])
}

model SmartTable {
  id           String             @id @default(cuid())
  tenantId     String
  tableNumber  String
  capacity     Int
  status       String
  section      String             @default("Main")
  order        String?
  amount       Float              @default(0)
  since        String?
  waiter       String?
  createdAt    DateTime           @default(now())
  orders       KDSOrder[]
  reservations SmartReservation[]
  waiterCalls  WaiterCall[]
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, section, tableNumber])
  @@index([tenantId])
  @@index([tenantId, status])
}

model WaiterCall {
  id           String     @id @default(cuid())
  tenantId     String
  tableId      String
  tableNumber  String
  message      String?
  status       String     @default("active")
  calledAt     DateTime   @default(now())
  dismissedAt  DateTime?
  expiresAt    DateTime
  table        SmartTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tableId])
}

model KDSOrder {
  id          String     @id @default(cuid())
  tenantId    String
  tableId     String
  description String
  status      String
  priority    String
  createdAt   DateTime   @default(now())
  completedAt DateTime?
  table       SmartTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tableId])
}

model SmartReservation {
  id              String     @id @default(cuid())
  tenantId        String
  tableId         String
  customerName    String
  customerPhone   String?
  guestCount      Int
  reservationTime DateTime
  notes           String?
  status          String
  createdAt       DateTime   @default(now())
  table           SmartTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  user      String
  action    String
  detail    String
  type      String
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model KassiHarakat {
  id            String   @id @default(cuid())
  tenantId      String
  type          String
  category      String
  amount        Float
  description   String?
  paymentMethod String   @default("Naqd pul")
  date          DateTime @default(now())
  createdBy     String?
  kontragent    String?
  createdAt     DateTime @default(now())
  refId         String?
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([type])
}

model DeliveryOrder {
  id            String    @id @default(cuid())
  tenantId      String
  orderNumber   String
  customerName  String
  customerPhone String
  address       String
  items         String
  totalAmount   Float
  status        String    @default("new")
  courierId     String?
  courierName   String?
  paymentMethod String    @default("Naqd pul")
  isPaid        Boolean   @default(false)
  notes         String?
  createdAt     DateTime  @default(now())
  deliveredAt   DateTime?
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
}

model SmartRecommendation {
  id                   String    @id @default(cuid())
  tenantId             String
  triggerProductId     String?
  triggerCategoryId    String?
  recommendProductId   String
  recommendProductName String
  title                String
  description          String    @default("")
  badgeText            String    @default("Tavsiya")
  badgeColor           String    @default("blue")
  discountType         String    @default("none")
  discountValue        Float     @default(0)
  priority             Int       @default(0)
  showAlways           Boolean   @default(false)
  minCartAmount        Float     @default(0)
  viewCount            Int       @default(0)
  clickCount           Int       @default(0)
  conversionCount      Int       @default(0)
  isActive             Boolean   @default(true)
  startDate            DateTime?
  endDate              DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([triggerProductId])
  @@index([triggerCategoryId])
  @@index([isActive, priority])
  @@index([tenantId, isActive])
}

model Attendance {
  id               String    @id @default(cuid())
  tenantId         String
  staffId          String
  staffName        String
  staffRole        String
  checkInTime      DateTime
  checkOutTime     DateTime?
  workDuration     Int?
  breakDuration    Int       @default(0)
  checkInLocation  String?
  checkOutLocation String?
  notes            String?
  status           String    @default("active")
  ipAddress        String?
  deviceInfo       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([staffId])
  @@index([tenantId, staffId])
  @@index([checkInTime])
  @@index([tenantId, checkInTime])
  @@index([status])
}

model PotentialClient {
  id              String    @id @default(cuid())
  agentCode       String
  businessName    String
  ownerName       String
  phone           String    @unique
  address         String?
  status          String    @default("new")
  nextContactDate DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([agentCode])
  @@index([status])
}

model Tariff {
  id            String   @id @default(cuid())
  name          String
  description   String?
  pricePerMonth Float    @default(0)
  durationDays  Int      @default(30)
  maxUsers      Int      @default(10)
  maxBranches   Int      @default(1)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  tenants       Tenant[]

  @@index([isActive])
  @@index([sortOrder])
}

model BalanceLog {
  id            String   @id @default(cuid())
  tenantId      String
  amount        Float
  logType       String
  note          String?
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, createdAt])
}

model PlatformSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String?
  updatedAt DateTime @updatedAt
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model UbtCategory {
  id        String? @id
  tenantId  String
  name      String
  type      String  @default("taom")
  itemCount Int     @default(0)
  createdAt String  @default("datetime('now')")

  @@ignore
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model UbtIngredient {
  id         String? @id
  tenantId   String
  name       String
  unit       String
  stock      Float   @default(0)
  price      Float   @default(0)
  type       String  @default("xomashyo")
  categoryId String?
  createdAt  String  @default("datetime('now')")

  @@ignore
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model UbtSupplier {
  id        String?   @id @default("lower(hex(randomblob(8)))")
  tenantId  String
  name      String
  phone     String?
  info      String?
  createdAt DateTime? @default(now())
  currency  String?   @default("UZS")

  @@ignore
}
