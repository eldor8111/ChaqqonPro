{
  "name": "smart-pos-v2",
  "version": "2.0.0",
  "description": "SMART POS V2 — Smart Kassa Dasturi (Online + Offline)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build-installer": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "uz.smart.smart-pos-v2",
    "productName": "SMART POS V2",
    "copyright": "Copyright © 2024 Smart",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SMART POS",
      "runAfterFinish": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false,
      "include": "installer.nsh"
    },
    "artifactName": "SMART-POS-Setup.exe",
    "files": [
      "main.js",
      "printer.js",
      "tray-agent.js",
      "preload.js",
      "splash.html",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": ["**/*"]
      },
      {
        "from": "nextjs-standalone",
        "to": "nextjs",
        "filter": ["**/*"]
      },
      {
        "from": "database",
        "to": "database",
        "filter": ["**/*"]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "publish": null
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "allowScripts": {
    "electron@28.3.3": true,
    "sharp@0.34.5": true
  }
}
